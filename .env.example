# AWS Credentials Configuration for Smart Watchdog
# 方式一：若使用 Workshop Studio / IAM 臨時金鑰，直接填入下列變數：
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-west-2

# 方式二：若使用 ~/.aws/credentials 具名 Profile，請設定此項（例如 workshop）：
# AWS_PROFILE=workshop

# Bedrock 模型設定（預設 Claude 3.5 / 4.5 Haiku active profile）
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
